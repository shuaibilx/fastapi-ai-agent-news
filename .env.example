# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_DB_PASSWORD
MYSQL_DATABASE=news_app
MYSQL_CHARSET=utf8mb4

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# LangGraph checkpointer uses the same Redis server's DB 0 because RediSearch
# indexes cannot be created in a non-zero Redis database.

# AI 新闻摘要（仅后端读取，绝不放入 Front-end/.env）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-server-only-ai-api-key
LLM_MODEL=your-summary-model
LLM_TIMEOUT_SECONDS=30
AI_SUMMARY_MAX_CHARACTERS=400
AI_SUMMARY_CACHE_TTL_SECONDS=2592000
AI_QA_RETRIEVAL_LIMIT=5
AI_QA_MAX_CONTEXT_CHARS=6000

# 本地语义检索（TEI + Redis Stack）
EMBEDDING_BASE_URL=http://127.0.0.1:8081
EMBEDDING_MODEL=bge-large-zh-v1.5
EMBEDDING_TIMEOUT_SECONDS=30
AI_SEMANTIC_INDEX_NAME=idx:ai:news:vector:v1
AI_SEMANTIC_KEY_PREFIX=ai:news:vector:v1:
AI_SEMANTIC_VECTOR_DIMENSIONS=1024
AI_SEMANTIC_BATCH_SIZE=4
AI_SEMANTIC_RETRIEVAL_LIMIT=5
AI_SEMANTIC_SCORE_THRESHOLD=0.35

# AI 新闻 Agent（只读工具 + Token 阈值短期记忆）
AI_AGENT_TOOL_RESULT_MAX_TOKENS=4000
AI_AGENT_INPUT_MAX_TOKENS=10000
AI_AGENT_SUMMARY_TRIGGER_TOKENS=6000
AI_AGENT_SUMMARY_KEEP_TOKENS=2500
# 可选：不填写时复用 LLM_MODEL
AI_AGENT_SUMMARY_MODEL=
AI_AGENT_MEMORY_TTL_SECONDS=86400
AI_AGENT_MAX_ITERATIONS=6

